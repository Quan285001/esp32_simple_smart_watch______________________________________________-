{
  "schemaVersion": 1,
  "designId": "sample-minimal-digital",
  "name": "Minimal Digital",
  "deviceProfileId": "esp32-c3-gc9a01-240",
  "canvas": {
    "width": 240,
    "height": 240,
    "shape": "circle",
    "backgroundColor": "#080B10",
