{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watch-face-studio.local/schemas/watch-face-project.schema.json",
  "title": "Watch Face Studio Portable Project",
  "description": "Portable project envelope containing a declarative watch face and its referenced source image assets.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "design",
    "assets"
  ],
  "properties": {
    "format": {
      "const": "watch-face-studio-project"
    },
    "version": {
      "const": 1
    },
    "design": {
      "type": "object"
    },
    "assets": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "data": {
            "type": "string",
            "maxLength": 8000000,
            "pattern": "^data:image/[A-Za-z0-9.+-]+;base64,"
          }
        }
      }
    }
  }
}
