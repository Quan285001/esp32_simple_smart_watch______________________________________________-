{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://watch-face-studio.local/schemas/watch-face.schema.json",
  "title": "Watch Face Studio Design",
  "description": "Declarative, versioned watch-face document. Executable code is never permitted.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "designId",
    "name",
    "deviceProfileId",
    "canvas",
    "objects"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "designId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "deviceProfileId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "shape",
        "backgroundColor"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "shape": {
          "enum": [
            "circle",
            "square",
            "rectangle",
            "rounded-square",
            "rounded-rectangle"
          ]
        },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "clipToShape": {
          "type": "boolean",
          "default": true
        },
        "safeArea": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "type": "number",
              "minimum": 0
            },
            "right": {
              "type": "number",
              "minimum": 0
            },
            "bottom": {
              "type": "number",
              "minimum": 0
            },
            "left": {
              "type": "number",
              "minimum": 0
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    },
    "objects": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/object"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1024,
          "maximum": 2048
        },
        "y": {
          "type": "number",
          "minimum": -1024,
          "maximum": 2048
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2048
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 2048
        },
        "rotation": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "anchor": {
          "enum": [
            "top-left",
            "center",
            "top-center",
            "bottom-center"
          ]
        },
        "zIndex": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fill": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "stroke": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 64
        },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "cornerRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 512
        }
      }
    },
    "glyphStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontId": {
          "type": "string",
          "maxLength": 64
        },
        "fontFamily": {
          "type": "string",
          "maxLength": 64
        },
        "textAlign": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "fontWeight": {
          "enum": [
            300,
            400,
            500,
            600,
            700,
            800,
            900
          ]
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 256
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 512
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 512
        },
        "scaleX": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 8
        },
        "scaleY": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 8
        },
        "fill": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "stroke": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0,
          "maximum": 32
        },
        "backgroundColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "backgroundShape": {
          "enum": [
            "none",
            "rectangle",
            "rounded-rectangle",
            "circle"
          ]
        },
        "backgroundRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 128
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rotation": {
          "type": "number",
          "minimum": -3600,
          "maximum": 3600
        },
        "letterSpacing": {
          "type": "number",
          "minimum": -64,
          "maximum": 128
        },
        "visible": {
          "type": "boolean"
        },
        "zIndex": {
          "type": "integer",
          "minimum": -32768,
          "maximum": 32767
        }
      }
    },
    "glyphOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector",
        "style"
      ],
      "properties": {
        "selector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "value"
          ],
          "properties": {
            "mode": {
              "enum": [
                "position",
                "digit-value",
                "occurrence",
                "separator"
              ]
            },
            "value": {
              "type": [
                "string",
                "integer"
              ],
              "maxLength": 16
            },
            "occurrence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 64
            }
          }
        },
        "style": {
          "$ref": "#/$defs/glyphStyle"
        },
        "offsetX": {
          "type": "number",
          "minimum": -512,
          "maximum": 512
        },
        "offsetY": {
          "type": "number",
          "minimum": -512,
          "maximum": 512
        }
      }
    },
    "object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "transform"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "background",
            "image",
            "shape",
            "analog-clock",
            "digital-clock",
            "date",
            "text",
            "weather",
            "moon",
            "sunrise-sunset",
            "gauge",
            "progress-ring",
            "group"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "visible": {
          "type": "boolean",
          "default": true
        },
        "locked": {
          "type": "boolean",
          "default": false
        },
        "transform": {
          "$ref": "#/$defs/transform"
        },
        "style": {
          "$ref": "#/$defs/style"
        },
        "assetId": {
          "type": "string",
          "maxLength": 64
        },
        "shape": {
          "enum": [
            "rect",
            "rounded-rect",
            "circle",
            "line",
            "arc"
          ]
        },
        "dataBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "enum": [
                "time",
                "date",
                "weekday",
                "temperature",
                "weather-condition",
                "rain-probability",
                "wind-speed",
                "sunrise",
                "sunset",
                "moonrise",
                "moonset",
                "custom-text"
              ]
            },
            "format": {
              "type": "string",
              "maxLength": 64
            },
            "timezone": {
              "type": "string",
              "maxLength": 64
            },
            "fallbackText": {
              "type": "string",
              "maxLength": 64
            },
            "visibleWhenMissing": {
              "type": "boolean",
              "default": false
            }
          }
        },
        "clockMode": {
          "enum": [
            "analog",
            "digital",
            "hybrid"
          ]
        },
        "timeFormat": {
          "enum": [
            "12h",
            "24h"
          ]
        },
        "showSeconds": {
          "type": "boolean"
        },
        "showAmPm": {
          "type": "boolean"
        },
        "handConfig": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hour": {
              "type": "object",
              "additionalProperties": true
            },
            "minute": {
              "type": "object",
              "additionalProperties": true
            },
            "second": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "text": {
          "type": "string",
          "maxLength": 256
        },
        "textStyle": {
          "$ref": "#/$defs/glyphStyle"
        },
        "glyphOverrides": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/glyphOverride"
          }
        },
        "glyphAtlasAssetId": {
          "type": "string",
          "maxLength": 64
        },
        "glyphFallback": {
          "enum": [
            "hide",
            "system-font",
            "compatibility-error"
          ]
        },
        "weatherFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "temperature",
              "condition",
              "icon",
              "rain-probability",
              "wind-speed",
              "sunrise",
              "sunset",
              "moonrise",
              "moonset"
            ]
          }
        },
        "children": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/object"
          }
        },
        "renderHints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preferredUpdateMs": {
              "type": "integer",
              "minimum": 100,
              "maximum": 86400000
            },
            "staticLayer": {
              "type": "boolean"
            },
            "requiresAntialias": {
              "type": "boolean"
            },
            "requiresBitmap": {
              "type": "boolean"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "image"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "assetId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "digital-clock"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "dataBinding"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "date"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "dataBinding"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "text"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "text"
                ]
              },
              {
                "required": [
                  "dataBinding"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "group"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "children"
            ]
          }
        }
      ]
    }
  }
}
